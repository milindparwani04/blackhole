# Copy to .env. Never commit real values (.env is git-ignored).
LISTEN_HOST=127.0.0.1
PORT=4317
DATA_DIR=data
# DATABASE_PATH=data/blackhole.sqlite
LOG_LEVEL=warn

# Games — IGDB via a Twitch developer application (https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Movies — TMDb "API Read Access Token" (long) or v3 "API Key" (32 chars) from https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=


# Trophy lookup — local SearXNG (D-02). Must be a 127.0.0.1/localhost URL. See searxng/settings.example.yml
SEARXNG_URL=http://127.0.0.1:8888
